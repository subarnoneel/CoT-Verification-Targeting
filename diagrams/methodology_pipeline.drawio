          vertex="1" parent="1"><mxGeometry x="306" y="592" width="84" height="24" as="geometry" /></mxCell>
        <mxCell id="lg2t" value="cheap &#8212; Qwen2.5-3B, whole study under US$5"
          style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#5C7396;fontFamily=Helvetica;"
          vertex="1" parent="1"><mxGeometry x="396" y="592" width="320" height="24" as="geometry" /></mxCell>

